#include <stdio.h>
#include <unistd.h>
#include <stdlib.h>

#define MAX 10

int fila[MAX], ffila=0, ifila=0;

void menu(){
    system("clear");
    printf("\n----------------MENU DE OPÇÕES------------------\n\n");
    printf("1-Enfileirar um número [0 encerra]: \n");
    printf("2-Desenfileirar e Exibir o dobro:  \n");
    printf("3-Desenfileirar Tudo:  \n");
    printf("4- Encerrar: \n");
    printf("Escolha a opção desejada: ");
}

int filaCheia(){
    return ((ffila + 1) % MAX == ifila);
}

int filaVazia(){
    return (ffila == ifila);
}

void enfileirar(int valor){
    if(filaCheia()){
        printf("\nFila Cheia!\n");
        fflush(stdout);
        sleep(2);
        return;
    }    
    fila[ffila] = valor;
    ffila = (ffila +1) % MAX;
}

void desenfileirarDobro(){
    system("clear");
    if(filaVazia()){
        printf("\nFila Vazia!");
        fflush(stdout);
        sleep(2);
    }else{
        printf("\nDesenfileirar valor (Dobro): ");
         printf("\nRemovido: %d\n", fila[ifila]*2);
        ifila = (ifila + 1) % MAX;
        fflush(stdout);
        sleep(2);
    }
    
    if(ifila == ffila){
        ifila = 0;
        ffila = 0;
    }
    
}

void desenfileirar(){
    system("clear");
    if(filaVazia()){
        printf("\nFila Vazia!");
        fflush(stdout);
        sleep(2);
    }else{
        printf("\nDesenfileirar: ");
        while(!filaVazia()){
                printf("\n %d",fila[ifila]);
            ifila = (ifila + 1) % MAX;
            if(ifila == ffila) break;
        }
        fflush(stdout);
        sleep(2);
    }
}

int main()
{
    int op=0,valor;
    
    
    do{
        menu();
        scanf("%d",&op);
        system("clear");
        
        switch (op){
            case 1:
                do{
                    
                    printf("\n-----------------ENFILEIRAR NÚMEROS------------------\n\n");
                    printf("Insira um Número positivo (0 encerra): ");
                    scanf("%d",&valor);
                    
                    if( valor < 0 ){
                        printf("\nNão é permitido números negativos");
                        fflush(stdout);
                        sleep(1);
                    }else if(ffila == MAX){
                        printf("\nFila Cheia!");
                        fflush(stdout);
                        sleep(1);
                    }else if(valor == 0){
                        printf("\nCadastro Encerrado!");
                        fflush(stdout);
                        sleep(1);
                    }else{
                        enfileirar(valor);
                        printf("\nNúmero Cadastrado com Sucesso!");
                        fflush(stdout);
                        sleep(1);
                    }
                    
                    system("clear");
                    
                }while( valor != 0 );
                
            break;
            
            case 2:
            desenfileirarDobro();
            break;
            
            case 3:
            desenfileirar();
            break;
            
            case 4:
            system("clear");
            printf("\nPrograma Encerrado!");
            break;
            
            default:
            system("clear");
            printf("\nOpção Inválida");
            break;
        }
    }while(op != 4);

    return 0;
}
